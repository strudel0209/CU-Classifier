# Azure AI Content Understanding (Microsoft Foundry resource)
CONTENTUNDERSTANDING_ENDPOINT=https://cog-tb7tpjtuee4ji.services.ai.azure.com/
# Optional – leave empty to use Entra ID (az login / managed identity) via DefaultAzureCredential
CONTENTUNDERSTANDING_KEY=

# GA = 2025-11-01 ; preview (layout-aware classification) = 2026-06-01-preview
CU_API_VERSION=2025-11-01

# Model NAME used by the analyzers (must be a supported Content Understanding model)
CU_COMPLETION_MODEL=gpt-5.2

# Only needed if SET_DEFAULTS=True in the notebook (maps model names -> your deployment names)
CU_COMPLETION_DEPLOYMENT=gpt-5.2
CU_EMBEDDING_MODEL=text-embedding-3-large
CU_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Analyzer IDs (letters, numbers, dots, underscores)
CU_ANALYZER_A=diagramTypeFieldClassifier
CU_ANALYZER_B=diagramTypeCategoryClassifier

# Folder of test images; sub-folders named after the expected label enable accuracy scoring
SAMPLES_DIR=./samples
